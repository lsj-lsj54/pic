# 部署环境变量模板
#
# 用法（推荐用封装脚本，它会带好 --env-file 参数）：
#   cp deploy/.env.example deploy/.env
#   vi deploy/.env                    # 填真实值
#   chmod 600 deploy/.env             # 里面是明文密钥，收紧权限
#   bash deploy/deploy.sh
#
# 手动方式：
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build
#
# deploy/.env 已在 .gitignore 里，不会被提交；这个模板可以提交。
# 注意：这里的值不要加引号，Compose 会原样读取。

# ---------- 站点 ----------
# 对外暴露的端口。大陆机器未备案时 80 端口会被拦，改成像 8080 这样的非标端口即可。
HTTP_PORT=80

# 镜像标签，留空则用 latest。
# deploy.sh 会自动用 git 短 SHA 覆盖它，方便知道线上跑的是哪个提交、也方便回滚。
# PICTURE_TAG=

# ---------- 数据库 ----------
# MySQL 容器里 root 账号的密码（给 mysql 容器自己用）
MYSQL_ROOT_PASSWORD=change-me-please

# 应用连库用的账号与密码
#   默认直接用 root：此时把 MYSQL_PASSWORD 填成和上面一样的值。
#   想按最小权限原则改用专用账号（推荐）：
#     1. 改好 deploy/mysql/create-app-user.sql 里的密码并执行它
#     2. 下面两行改成 MYSQL_USERNAME=picture_app / MYSQL_PASSWORD=<那个独立密码>
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-please

# ---------- Redis ----------
REDIS_PASSWORD=change-me-too

# ---------- 腾讯云 COS ----------
# 取名规则见 https://console.cloud.tencent.com/cam/capi
#
# 【强烈建议】不要在服务器上使用主账号密钥。
# 请新建一个子用户，只授予「对象存储 COS」权限，并限制到本项目用的那个桶，
# 密钥一旦泄露，影响面能控制在这一个桶里。步骤见 docs/deploy.md「COS 子账号最小权限」。
#
# host / bucket 里的 your-bucket-appid 要带 APPID 后缀，例如 picture-1504102210
COS_HOST=https://your-bucket-appid.cos.ap-guangzhou.myqcloud.com
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-appid

# ---------- 备份（deploy/backup.sh 使用，可留空）----------
# 备份保留天数
BACKUP_KEEP_DAYS=7
# 备份目录
BACKUP_DIR=/var/backups/picture
